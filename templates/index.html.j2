<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ google_analytics_id }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', '{{ google_analytics_id }}');
    </script>
    <title>3D Parcel Map</title>
    <meta name="viewport" content="initial-scale=1,maximum-scale=1,user-scalable=no" />
    <link href="https://unpkg.com/maplibre-gl@4.3.2/dist/maplibre-gl.css" rel="stylesheet" />
    <link href="https://cdn.maptiler.com/maptiler-geocoding-control/v2.1.7/style.css" rel="stylesheet" />
    <script src="https://unpkg.com/maplibre-gl@4.3.2/dist/maplibre-gl.js"></script>
    <script src="https://cdn.maptiler.com/maptiler-geocoding-control/v2.1.7/maplibregl.umd.js"></script>
    <style>
        body {
            margin: 0;
            padding: 0;
        }

        #map {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 100%;
        }

        #legend {
            position: absolute;
            bottom: 0;
            right: 0;
            min-width: 420px;
            border: 1px solid #000;
            border-bottom: 0;
            border-right: 0;
            border-radius: 4px 0 0 0;
            background: #fff;
            padding: 5px;
            box-sizing: border-box;
        }

        @media (max-width: 420px) {
            #legend {
                min-width: 0;
                width: 100%;
                border-left: 0;
                border-radius: 0;
            }
        }

        #gradient {
            background: linear-gradient(to right, green 0%, blue 25%, red 50%, yellow 75%, white 100%);
            border: 1px solid #000;
            height: 40px;
        }

        .title {
            text-align: center;
            margin: 5px 0;
        }
        .labels {
            display: flex;
            justify-content: space-between;
        }
        .label {
            font-size: 10px;
        }
        .title label {
            cursor: pointer;
            user-select: none;
        }
        #options {
            text-align: center;
            margin: 5px 0;
        }
        .help-icon {
            display: inline-block;
            width: 14px;
            height: 14px;
            line-height: 14px;
            border-radius: 50%;
            background: #888;
            color: #fff;
            font-size: 10px;
            text-align: center;
            cursor: pointer;
            position: relative;
            vertical-align: middle;
            margin-left: 2px;
        }
        .help-tooltip {
            display: none;
            position: absolute;
            bottom: 22px;
            right: -10px;
            width: 260px;
            background: #333;
            color: #fff;
            font-size: 12px;
            padding: 8px 10px;
            border-radius: 4px;
            line-height: 1.4;
            z-index: 10;
            text-align: left;
            font-weight: normal;
        }
        .help-tooltip a {
            color: #ccc;
        }
        .help-icon:hover .help-tooltip,
        .help-tooltip.visible {
            display: block;
        }
        .parcel-popup table {
            border-collapse: collapse;
            font-size: 13px;
        }
        .parcel-popup td {
            padding: 2px 6px;
        }
        .parcel-popup td:first-child {
            font-weight: bold;
            text-align: right;
        }
    </style>
</head>

<body>

    <div id="map"></div>
    <div id="legend">
        <h3 class="title">
            Appraised Value per Acre ($ / Acre)
        </h3>
        <div class="labels">
            <div class="zero label">0</div>
            <div class="one label">500K</div>
            <div class="two label">2M</div>
            <div class="three label">10M</div>
            <div class="four label">40M</div>
        </div>
        <div id="gradient"></div>
        <div id="options">
            <label><input type="checkbox" id="extrusion-toggle" checked /> 3D</label>
            <label><input type="checkbox" id="exempt-toggle" checked /> Include Tax Exempt</label>
            <span class="help-icon">
                <span id="exempt-help">?</span>
                <span class="help-tooltip">Tax-exempt status is a best guess based on State Use codes in the CT parcel data. This may not match official town records exactly. See <a href="https://github.com/ericfs/land_value_map/tree/main/agent/state_use_codes.md" target="_blank">notes</a>.</span>
            </span>
        </div>
    </div>
    <script>
        // Toggle help tooltip on click (for touch devices)
        document.getElementById('exempt-help').addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            document.querySelector('.help-icon .help-tooltip').classList.toggle('visible');
        });
        document.addEventListener('click', function () {
            var tip = document.querySelector('.help-icon .help-tooltip');
            if (tip) tip.classList.remove('visible');
        });

        // You'll need an API key from a basemap provider like Maptiler or Stadia.
        // Get a free key from: https://www.maptiler.com/cloud/
        const apiKey = '{{ maptiler_api_key }}';

        const map = new maplibregl.Map({
            container: 'map',
            style: `https://api.maptiler.com/maps/streets-v2/style.json?key=${apiKey}`,
            center: [-72.811096, 41.282098],
            zoom: 11,
            pitch: 45,
            bearing: -17.6,
            attributionControl: false
        });

        // Geocoding search control
        var gc = new maplibreglMaptilerGeocoder.GeocodingControl({
            apiKey: apiKey,
            placeholder: 'Search for a location...',
            proximity: [-72.75, 41.74],
            bbox: [-73.73, 40.95, -71.79, 42.05],
            limit: 5
        });
        map.addControl(gc, 'top-left');

        const parcelLayers = [];
        gc.on('pick', function (e) {
            if (!e.feature) return;
            var coords = e.feature.center;
            map.once('moveend', function () {
                var point = map.project(coords);
                var features = map.queryRenderedFeatures(point, { layers: parcelLayers });
                if (features.length === 1) {
                    showParcelPopup(features[0].properties, coords);
                }
            });
        });

        map.addControl(new maplibregl.AttributionControl({
            customAttribution: '© <a href="https://github.com/ericfs/land_value_map" target="_blank">Stronger Haven</a> {{ now().strftime('%Y') }}',
            compact: true
        }), 'top-left');

        const lvpa_expression = ["/", ["get", "Appraised_Total"], ["get", "Land_Acres"]];

        const normalColorExpression = [
            "interpolate",
            ["linear"],
            lvpa_expression,
            0, "green",
            500000, "blue",
            2000000, "red",
            10000000, "yellow",
            40000000, "white",
        ];

        const exemptColorExpression = [
            "case",
            ["==", ["get", "Tax_Exempt"], 1],
            "#555555",
            normalColorExpression,
        ];

        const normalHeightExpression = ["/", lvpa_expression, 5000];

        const exemptHeightExpression = [
            "case",
            ["==", ["get", "Tax_Exempt"], 1],
            0,
            normalHeightExpression,
        ];

        let currentPopup = null;

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function showParcelPopup(props, lngLat) {
            if (currentPopup) currentPopup.remove();

            const appraised = props.Appraised_Total;
            const acres = props.Land_Acres;
            const perAcre = acres > 0 ? appraised / acres : 0;
            const fmt = (v) => '$' + Math.round(v).toLocaleString();

            let addressRow = '';
            if (props.Location && props.Location.trim() !== '') {
                const label = map.getZoom() >= 11 ? 'Address' : 'Near';
                addressRow = `<tr><td>${label}</td><td>${escapeHtml(props.Location)}</td></tr>`;
            }

            let exemptRow = '';
            if (props.Tax_Exempt === 1) {
                exemptRow = '<tr><td>Status</td><td>Tax Exempt</td></tr>';
            }

            const html = `<div class="parcel-popup"><table>
                ${addressRow}
                ${exemptRow}
                <tr><td>Appraised Value</td><td>${fmt(appraised)}</td></tr>
                <tr><td>Land Area</td><td>${Number(acres).toFixed(3)} acres</td></tr>
                <tr><td>Value / Acre</td><td>${fmt(perAcre)}</td></tr>
            </table></div>`;

            currentPopup = new maplibregl.Popup()
                .setLngLat(lngLat)
                .setHTML(html)
                .addTo(map);
        }

        map.on('load', () => {
            // 1. ADD THE VECTOR TILE SOURCE
            // This points to your locally hosted tile.json file.
            // Replace the URL with the actual path to your tile.json.
            map.addSource('parcels-source', {
                type: 'vector',
                url: '{{ version }}/tile.json' // <--- IMPORTANT
            });

            // 2. ADD PARCEL LAYERS
            map.addLayer({
                'id': 'parcels-3d',
                'type': 'fill-extrusion',
                'source': 'parcels-source',
                'source-layer': 'parcels',
                'minzoom': 6,
                'paint': {
                    'fill-extrusion-color': normalColorExpression,
                    'fill-extrusion-opacity': 1,
                    'fill-extrusion-height': normalHeightExpression,
                }
            });

            map.addLayer({
                'id': 'parcels-flat',
                'type': 'fill',
                'source': 'parcels-source',
                'source-layer': 'parcels',
                'minzoom': 6,
                'layout': { 'visibility': 'none' },
                'paint': {
                    'fill-color': normalColorExpression,
                    'fill-opacity': 0.85,
                }
            });

            parcelLayers.push('parcels-3d', 'parcels-flat');

            // Click handler — show popup with parcel details
            parcelLayers.forEach(layer => {
                map.on('click', layer, (e) => {
                    if (!e.features || e.features.length === 0) return;
                    showParcelPopup(e.features[0].properties, e.lngLat);
                });
                map.on('mouseenter', layer, () => {
                    map.getCanvas().style.cursor = 'pointer';
                });
                map.on('mouseleave', layer, () => {
                    map.getCanvas().style.cursor = '';
                });
            });

            // Extrusion toggle
            document.getElementById('extrusion-toggle').addEventListener('change', (e) => {
                if (e.target.checked) {
                    map.setLayoutProperty('parcels-3d', 'visibility', 'visible');
                    map.setLayoutProperty('parcels-flat', 'visibility', 'none');
                    map.easeTo({ pitch: 45, bearing: -17.6 });
                } else {
                    map.setLayoutProperty('parcels-3d', 'visibility', 'none');
                    map.setLayoutProperty('parcels-flat', 'visibility', 'visible');
                    map.easeTo({ pitch: 0, bearing: 0 });
                }
            });

            // Tax exempt toggle
            document.getElementById('exempt-toggle').addEventListener('change', (e) => {
                if (e.target.checked) {
                    // Include tax exempt: treat all parcels the same
                    map.setPaintProperty('parcels-3d', 'fill-extrusion-color', normalColorExpression);
                    map.setPaintProperty('parcels-3d', 'fill-extrusion-height', normalHeightExpression);
                    map.setPaintProperty('parcels-flat', 'fill-color', normalColorExpression);
                } else {
                    // Exclude tax exempt: grey color, 0 height
                    map.setPaintProperty('parcels-3d', 'fill-extrusion-color', exemptColorExpression);
                    map.setPaintProperty('parcels-3d', 'fill-extrusion-height', exemptHeightExpression);
                    map.setPaintProperty('parcels-flat', 'fill-color', exemptColorExpression);
                }
            });

            map.touchPitch.enabled();
        });
    </script>

</body>

</html>