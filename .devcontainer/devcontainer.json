{
  "name": "Land Value Map Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.ansible",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "mounts": [
    // Mount the parent directory so that input files as configured in the scripts (e.g. ../Parcel Collection 2024) are accessible
    "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind,consistency=cached"
  ],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "pip3 install -r ansible/requirements.txt",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false
}